# OhHike marketing site — apps/web (build from monorepo root)
# Dokploy: Dockerfile path = Dockerfile.web, Context = .

FROM node:20-bookworm-slim AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

FROM base AS builder
COPY . .
RUN pnpm install --frozen-lockfile

# This is baked into static/client output. Default matches the hosted OhHike app;
# Dokploy can still override it with a build-time argument for other domains.
ARG NEXT_PUBLIC_APP_URL=https://app.ohhike.com
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL

RUN node apps/web/scripts/validate-docker-build-env.mjs
RUN pnpm turbo build --filter=web

FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

WORKDIR /app
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static

EXPOSE 3000
CMD ["sh", "-c", "HOSTNAME=0.0.0.0 exec node apps/web/server.js"]
