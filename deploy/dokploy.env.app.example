# Dokploy → Application: ohhike-app
# Paste as KEY=VALUE lines (no quotes). Use production URLs.

NODE_ENV=production
PORT=3000

# Public (required at BUILD + runtime for Next.js)
NEXT_PUBLIC_APP_URL=https://app.your-domain.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Server-only (runtime; never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
CLERK_SECRET_KEY=sk_live_...
CLERK_ENCRYPTION_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Optional AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Optional invite email delivery
RESEND_API_KEY=
INVITE_EMAIL_FROM=OhHike <invites@your-domain.com>
