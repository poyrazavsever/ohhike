# Dokploy → Application: ohhike-web
# Marketing site only — do NOT paste full app secrets here.

NODE_ENV=production
PORT=3000

# Where the Coach app lives (pricing / Get Started buttons).
# Also add the same key/value under Dokploy -> Build-time Arguments for web.
NEXT_PUBLIC_APP_URL=https://app.your-domain.com

# Coach Network — must be true at BUILD TIME and runtime (Next.js inlines NEXT_PUBLIC_*).
# If false/unset in production: /find-coach, /login, navbar Coaches → 404 or hidden.
NEXT_PUBLIC_COACH_NETWORK_ENABLED=true
NEXT_PUBLIC_WEB_URL=https://ohhike.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ENCRYPTION_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
